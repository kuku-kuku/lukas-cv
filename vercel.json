{
  "build": {
    "env": {
      "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
    }
  },
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "comment": "Prerendered routes (/ and /en) are real files and are served from the filesystem first. Everything else - the client-side demo sandbox and any unknown URL - falls through to the SPA shell, which renders the right route or the 404 page.",
      "source": "/(.*)",
      "destination": "/__spa-fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
